<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /HertiX/admin/
  
  # Stop rewriting if requested path starts with dist/ to avoid infinite loops
  RewriteRule ^dist/ - [L]

  # For Vite assets (which are placed in dist/assets), route them directly
  RewriteRule ^(assets/.*|vite\.svg)$ dist/$1 [L]
  
  # Force the directory root and unbuilt index.html to serve the production built index
  RewriteRule ^(index\.html)?$ dist/index.html [L]

  # Serve non-existent paths via dist/index.html (SPA routing)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>
